<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.folddeck.spike"
    android:versionCode="26"
    android:versionName="0.13.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Phone mic/camera keep serving laptop apps while FoldDeck is hidden or locked:
         a microphone|camera foreground service (API 34+ needs the typed permissions). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- To tell the laptop when the phone is on mobile data (lower stream quality). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Without this BiometricManager throws SecurityException, which the lock
         screen reads as "no fingerprint", so the prompt silently never appears. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- res/ holds only the launcher icon; everything else uses framework themes,
         so the whole APK still builds with aapt2 + javac + d8 and needs no
         Gradle, no wrapper jar and no network. -->
    <application
        android:label="FoldDeck"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true">

        <!-- configChanges keeps a rotation or fold from tearing down the Surface
             and the socket mid-measurement. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboard|keyboardHidden|navigation|uiMode"
            android:screenOrientation="fullUser"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".SharingService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />
    </application>
</manifest>
