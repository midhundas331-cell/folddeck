<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.folddeck.spike"
    android:versionCode="3"
    android:versionName="0.3">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Without this BiometricManager throws SecurityException, which the lock
         screen reads as "no fingerprint", so the prompt silently never appears. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- res/ holds only the launcher icon; everything else uses framework themes,
         so the whole APK still builds with aapt2 + javac + d8 and needs no
         Gradle, no wrapper jar and no network. -->
    <application
        android:label="FoldDeck"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="true">

        <!-- configChanges keeps a rotation or fold from tearing down the Surface
             and the socket mid-measurement. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboard|keyboardHidden|navigation|uiMode"
            android:screenOrientation="userLandscape"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
