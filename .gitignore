# Build output
android/build/
__pycache__/
*.pyc

# Generated by install-autostart.sh, and it hardcodes absolute paths.
host/autostart.sh

# The debug signing key.
#
# Private keys do not belong in git, even a debug one with the well-known
# password "android". But there is a real cost to losing it: Android refuses to
# install an APK signed with a different key over an existing one, so a lost
# keystore means uninstalling the app (and losing its PIN and pairing) before
# you can update it again. Back it up somewhere outside the repo.
#
# If you would rather version it anyway and accept that, it is one command:
#     git add -f android/debug.keystore
android/debug.keystore

# Runtime state lives in ~/.config/folddeck (TLS key, paired devices) and is
# deliberately outside the repo. Listed here in case anyone symlinks it in.
server.key
server.crt
authorized_clients
